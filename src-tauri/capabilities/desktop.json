{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Permisos de escritorio (incluye updater y process)",
  "platforms": ["windows", "macOS", "linux"],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:scope-download-recursive",
    "fs:scope-desktop-recursive",
    "fs:scope-home-recursive",
    "process:default"
  ]
}
