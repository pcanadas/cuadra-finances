{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permisos de Android (sin updater ni process: actualiza Google Play)",
  "platforms": ["android"],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-exit",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-file"
  ]
}
