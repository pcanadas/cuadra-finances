{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cuadra",
  "version": "0.6.1",
  "identifier": "com.xyfos.cuadra",
  "mainBinaryName": "Cuadra",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cuadra — Finanzas del hogar",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwQUMyNEU0RDE1REFCMUMKUldRY3ExM1I1Q1NzQUFaaVNuUnVBdDZGQTQxYUNHc1ZCQVQwSzNaUEZhdUtIWFZJZThrYTJ4WjkK",
      "endpoints": [
        "https://raw.githubusercontent.com/pcanadas/cuadra-finances/main/releases/latest.json"
      ],
      "dialog": false
    }
  }
}
